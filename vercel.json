{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{node_modules/@ai-sdk/**,node_modules/ai/**,node_modules/zod/**,node_modules/eventsource-parser/**,node_modules/json-schema/**,node_modules/@standard-schema/**,node_modules/@workflow/**,node_modules/undici/**,node_modules/@vercel/oidc/**}"
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "yagyu.ai" }],
      "destination": "https://yagyu.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.yagyu.ai" }],
      "destination": "https://yagyu.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
