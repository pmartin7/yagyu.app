# Database — two credentials by design (see ARCHITECTURE.md § Row-Level Security).
# Owner credential: migrations and the MikroORM CLI (bypasses RLS on Neon).
NEON_DATABASE_URL=postgresql://neondb_owner:password@host/dbname?sslmode=require
# RLS-bound app_user credential: the API runtime. Pooled host on Vercel,
# direct host locally. Without this, every runtime query is blocked by policy.
NEON_APP_DATABASE_URL=postgresql://app_user:password@host/dbname?sslmode=require
# Least-privilege cross-user credential for sync and triage workers. Pool max 1.
# After the migration, provision its login once per environment:
#   alter role worker_user with login password '<generated>';
NEON_WORKER_DATABASE_URL=postgresql://worker_user:password@host/dbname?sslmode=require

# Firebase Admin SDK (server)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Firebase client SDK (web, build-time)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# AI Providers. Configure only providers referenced by the model settings below.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default model — format: provider:model-id
# Examples: anthropic:claude-sonnet-5  openai:gpt-5.6-luna
# Measured triage winners (pnpm bench:triage, 2026-08-10 fixtures): gpt-5.6-luna
# for screen/route/write (best accuracy/cost). Re-run the harness before changing.
DEFAULT_AI_MODEL=openai:gpt-5.6-luna
# Optional per-agent overrides. Each falls back to DEFAULT_AI_MODEL.
# This allows independent model benchmarking and rollout with frozen prompts.
# AI_MODEL_SCREEN=openai:gpt-5.6-luna
# AI_MODEL_ROUTE=openai:gpt-5.6-luna
# AI_MODEL_WRITE=openai:gpt-5.6-luna

# Google OAuth (Gmail account linking)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Symmetric key for encrypting stored refresh tokens — generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Email sync worker
# Generate a long random bearer secret, for example: openssl rand -base64 32
CRON_SECRET=
# Optional Gmail push mode. Leave unset to use 10-minute polling only.
# GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications
# PUBSUB_PUSH_SERVICE_ACCOUNT=gmail-push@your-project.iam.gserviceaccount.com

# Google OAuth (web, build-time — same client ID as above)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Observability (optional)
AXIOM_TOKEN=xaat-...
AXIOM_DATASET=forge-logs

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Vercel Blob (optional — add-blob-storage skill)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
